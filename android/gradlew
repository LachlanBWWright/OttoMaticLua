#!/bin/bash
# Gradle wrapper script for Otto Matic Android build

# Resolve the directory containing this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Set JAVA_HOME if not set
if [ -z "$JAVA_HOME" ]; then
    if [ -x "/usr/lib/jvm/java-17-openjdk-amd64/bin/java" ]; then
        export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
    elif [ -x "/usr/lib/jvm/java-11-openjdk-amd64/bin/java" ]; then
        export JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
    fi
fi

# Download gradle wrapper jar if not present
WRAPPER_JAR="$SCRIPT_DIR/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading Gradle wrapper..."
    GRADLE_VERSION="8.4"
    WRAPPER_URL="https://raw.githubusercontent.com/gradle/gradle/v${GRADLE_VERSION}/gradle/wrapper/gradle-wrapper.jar"
    curl -o "$WRAPPER_JAR" "$WRAPPER_URL" 2>/dev/null || wget -O "$WRAPPER_JAR" "$WRAPPER_URL"
fi

# Run Gradle
java -jar "$WRAPPER_JAR" "$@"
